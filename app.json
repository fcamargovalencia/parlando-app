{
  "expo": {
    "name": "ParlAndo",
    "slug": "parlando-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parlando",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/parlando-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parlando.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCoH_l5VxTOfr_pJ2yYitH6tUZl2nxinFQ"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ParlAndo necesita tu ubicación para buscar viajes cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ParlAndo necesita tu ubicación en segundo plano para compartir tu viaje en tiempo real.",
        "NSCameraUsageDescription": "ParlAndo necesita acceso a la cámara para verificar tu identidad.",
        "NSFaceIDUsageDescription": "ParlAndo usa Face ID para autenticación rápida.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007380"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.parlando.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCoH_l5VxTOfr_pJ2yYitH6tUZl2nxinFQ"
        }
      },
      "navigationBarColor": "#FFFFFF",
      "navigationBarStyle": "dark-content",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ParlAndo necesita tu ubicación para compartir tu viaje en tiempo real con tus contactos de emergencia."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ParlAndo necesita acceso a tu cámara para verificar tu identidad."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#007380"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que ParlAndo use Face ID para inicio de sesión rápido."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4baece9-3dfb-462f-9bed-78c3fbb76c5f"
      }
    }
  }
}